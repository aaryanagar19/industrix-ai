# Copy to .env and edit. NEVER commit .env.
# --- Database (leave DATABASE_URL unset locally to use SQLite at ./industrix.db) ---
# DATABASE_URL=postgresql+psycopg2://industrix:change-me@localhost:5432/industrix
POSTGRES_USER=industrix
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=industrix
# --- Security (generate: python -c "import secrets;print(secrets.token_urlsafe(48))") ---
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
ALLOW_SELF_REGISTER=true
DEFAULT_REGISTER_ROLE=plant_manager
# --- Simulator ---
SIMULATOR_AUTOSTART=true
SIMULATOR_INTERVAL_SECONDS=3
SEED_ON_START=true
# --- Optional overrides of learned risk thresholds (calibrated probabilities) ---
# RISK_THRESHOLD_MODERATE=0.02
# RISK_THRESHOLD_HIGH=0.12
# RISK_THRESHOLD_CRITICAL=0.2
# --- Optional LLM summaries (OpenAI-compatible). Not required. ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# --- Frontend (build time) ---
# VITE_API_URL=https://your-backend.example.com
